[core]
	editor = zed --wait
	ignorecase = false
	autocrlf = input
	pager = delta
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
	pruneTags = true
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true
[includeIf "gitdir:~/dotfiles/**"]
	path = ./config.main
[includeIf "gitdir:~/Developer/**"]
	path = ./config.main

