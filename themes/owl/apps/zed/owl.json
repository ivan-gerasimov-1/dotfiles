{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Owl",
  "author": "Ivan",
  "themes": [
    {
      "name": "Owl",
      "appearance": "dark",
      "style": {
        "background": "#2f2b2c",
        "surface.background": "#302c2c",
        "elevated_surface.background": "#3a3637",
        "text": "#dedede",
        "text.muted": "#989898",
        "text.placeholder": "#7f7f7f",
        "text.disabled": "#656565",
        "text.accent": "#da5b2c",
        "icon": "#cacaca",
        "icon.muted": "#989898",
        "icon.disabled": "#656565",
        "icon.placeholder": "#7f7f7f",
        "icon.accent": "#da5b2c",
        "border": "#5d595b",
        "border.variant": "#3a3637",
        "border.focused": "#989898",
        "border.selected": "#dedede",
        "border.transparent": "#00000000",
        "border.disabled": "#3a3637",
        "element.background": "#302c2c",
        "element.hover": "#3a3637",
        "element.active": "#5d595b",
        "element.selected": "#5d595b",
        "element.disabled": "#302c2c",
        "drop_target.background": "#5d595b80",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#3a3637",
        "ghost_element.active": "#5d595b",
        "ghost_element.selected": "#5d595b",
        "status_bar.background": "#302c2c",
        "title_bar.background": "#2f2b2c",
        "toolbar.background": "#302c2c",
        "tab_bar.background": "#2f2b2c",
        "tab.inactive_background": "#2f2b2c",
        "tab.active_background": "#302c2c",
        "panel.background": "#2f2b2c",
        "panel.focused_border": "#5d595b",
        "pane.focused_border": "#5d595b",
        "scrollbar.thumb.background": "#5d595b",
        "scrollbar.thumb.hover_background": "#7f7f7f",
        "search.match_background": "#5d595b",
        "editor.foreground": "#dedede",
        "editor.background": "#2f2b2c",
        "editor.gutter.background": "#2f2b2c",
        "editor.subheader.background": "#302c2c",
        "editor.active_line.background": "#302c2c",
        "editor.highlighted_line.background": "#3a3637",
        "editor.line_number": "#7f7f7f",
        "editor.active_line_number": "#dedede",
        "editor.invisible": "#656565",
        "editor.wrap_guide": "#3a3637",
        "editor.active_wrap_guide": "#5d595b",
        "editor.document_highlight.read_background": "#5d595b66",
        "editor.document_highlight.write_background": "#5d595b80",
        "terminal.background": "#2f2b2c",
        "terminal.foreground": "#dedede",
        "terminal.ansi.black": "#302c2c",
        "terminal.ansi.red": "#5a5a5a",
        "terminal.ansi.green": "#989898",
        "terminal.ansi.yellow": "#cacaca",
        "terminal.ansi.blue": "#656565",
        "terminal.ansi.magenta": "#b1b1b1",
        "terminal.ansi.cyan": "#7f7f7f",
        "terminal.ansi.white": "#dedede",
        "terminal.ansi.bright_black": "#5d595b",
        "terminal.ansi.bright_red": "#da5b2c",
        "terminal.ansi.bright_green": "#989898",
        "terminal.ansi.bright_yellow": "#cacaca",
        "terminal.ansi.bright_blue": "#656565",
        "terminal.ansi.bright_magenta": "#b1b1b1",
        "terminal.ansi.bright_cyan": "#7f7f7f",
        "terminal.ansi.bright_white": "#ffffff",
        "link_text.hover": "#da5b2c",
        "version_control.added": "#cacaca",
        "version_control.modified": "#b1b1b1",
        "version_control.deleted": "#da5b2c",
        "version_control.conflict": "#da5b2c",
        "version_control.ignored": "#656565",
        "version_control.renamed": "#989898",
        "version_control.conflict.marker": "#da5b2c",
        "syntax": {
          "attribute": { "color": "#cacaca" },
          "boolean": { "color": "#989898" },
          "comment": { "color": "#7f7f7f", "font_style": "italic" },
          "constant": { "color": "#cacaca" },
          "constructor": { "color": "#dedede" },
          "embedded": { "color": "#dedede" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#cacaca" },
          "function": { "color": "#dedede", "font_weight": 600 },
          "hint": { "color": "#7f7f7f" },
          "keyword": { "color": "#cacaca" },
          "label": { "color": "#989898" },
          "link_uri": { "color": "#da5b2c" },
          "number": { "color": "#989898" },
          "operator": { "color": "#989898" },
          "predictive": { "color": "#656565" },
          "preproc": { "color": "#989898" },
          "primary": { "color": "#dedede" },
          "property": { "color": "#dedede" },
          "punctuation": { "color": "#7f7f7f" },
          "punctuation.bracket": { "color": "#7f7f7f" },
          "punctuation.delimiter": { "color": "#7f7f7f" },
          "punctuation.list_marker": { "color": "#da5b2c" },
          "punctuation.special": { "color": "#989898" },
          "string": { "color": "#cacaca" },
          "string.escape": { "color": "#b1b1b1" },
          "string.regex": { "color": "#b1b1b1" },
          "string.special": { "color": "#b1b1b1" },
          "string.special.symbol": { "color": "#b1b1b1" },
          "tag": { "color": "#cacaca" },
          "text.literal": { "color": "#cacaca" },
          "title": { "color": "#dedede", "font_weight": 700 },
          "type": { "color": "#cacaca" },
          "variable": { "color": "#dedede" },
          "variable.special": { "color": "#cacaca" }
        }
      }
    }
  ]
}
