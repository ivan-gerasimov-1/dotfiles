initial-command = direct:/opt/homebrew/bin/herdr

theme = owl

auto-update = off
confirm-close-surface = false
notify-on-command-finish = unfocused
quit-after-last-window-closed = true

background-blur = true
background-opacity = 0.9625
font-family = Iosevka
font-size = 14
fullscreen = non-native
macos-titlebar-style = tabs
macos-window-buttons = hidden
macos-window-shadow = false
window-padding-x = 0
window-padding-y = 0

keybind = ctrl+1=unbind
keybind = ctrl+2=unbind
keybind = ctrl+3=unbind
keybind = ctrl+4=unbind
keybind = ctrl+5=unbind
keybind = ctrl+6=unbind
keybind = ctrl+7=unbind
keybind = ctrl+8=unbind
keybind = ctrl+9=unbind
keybind = super+[=unbind
keybind = super+]=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+r=unbind
keybind = super+b=unbind
keybind = super+backslash=unbind
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+d=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind
keybind = super+enter=unbind
keybind = super+k=unbind
keybind = super+n=unbind
keybind = super+r=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+shift+d=unbind
keybind = super+shift+r=unbind
keybind = super+shift+w=unbind
keybind = super+t=unbind
keybind = super+w=unbind

# Emit navigation keys instead of readline commands so these also work in
# Neovim's insert mode.
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F
keybind = alt+arrow_left=text:\x1b[1;5D
keybind = alt+arrow_right=text:\x1b[1;5C
keybind = alt+backspace=text:\x1b\x7f
keybind = ctrl+key_b=text:\x02
keybind = super+alt+key_r=text:\x1b[114;11u
keybind = super+key_b=text:\x1b[98;9u
keybind = super+key_d=text:\x1b[100;9u
keybind = super+key_k=text:\x1b[107;9u
keybind = super+key_n=text:\x1b[110;9u
keybind = super+key_r=text:\x1b[114;9u
keybind = super+key_t=text:\x1b[116;9u
keybind = super+key_w=text:\x1b[119;9u
keybind = super+ctrl+key_h=text:\x1b[104;13u
keybind = super+ctrl+key_j=text:\x1b[106;13u
keybind = super+ctrl+key_k=text:\x1b[107;13u
keybind = super+ctrl+key_l=text:\x1b[108;13u
