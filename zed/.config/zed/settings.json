{
  "buffer_font_weight": 400.0,
  "buffer_line_height": "standard",
  "git": {
    "blame": {
      "show_avatar": false
    },
    "inline_blame": {
      "enabled": false
    }
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "folder_icons": false,
    "tree_view": true,
    "button": true
  },
  "outline_panel": {
    "button": false
  },
  "zoomed_padding": true,
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_close_button": "hover",
    "file_icons": false,
    "git_status": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": false,
    "cursor_position_button": false,
    "active_language_button": true
  },
  "project_panel": {
    "hide_root": true,
    "indent_guides": {
      "show": "never"
    },
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "show_diagnostics": "all",
    "bold_folder_labels": false,
    "starts_open": false,
    "auto_reveal_entries": true,
    "indent_size": 4.0,
    "git_status": true,
    "folder_icons": false,
    "file_icons": false,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "dock": "right",
    "button": false
  },
  "file_finder": {
    "file_icons": false
  },
  "message_editor": {
    "auto_replace_emoji_shortcode": false
  },
  "middle_click_paste": false,
  "word_diff_enabled": true,
  "tasks": {
    "enabled": false
  },
  "inlay_hints": {
    "enabled": false
  },
  "completions": {
    "words": "disabled"
  },
  "show_whitespaces": "trailing",
  "use_on_type_format": false,
  "indent_guides": {
    "enabled": true
  },
  "hard_tabs": false,
  "tab_size": 2,
  "scrollbar": {
    "show": "auto",
    "selected_symbol": true,
    "selected_text": true,
    "search_results": true,
    "cursors": true,
    "git_diff": true
  },
  "toolbar": {
    "selections_menu": true,
    "code_actions": true,
    "agent_review": false,
    "quick_actions": false,
    "breadcrumbs": false
  },
  "inline_code_actions": true,
  "relative_line_numbers": "disabled",
  "gutter": {
    "min_line_number_digits": 2,
    "bookmarks": false,
    "folds": true,
    "breakpoints": true,
    "runnables": true,
    "line_numbers": false
  },
  "show_wrap_guides": true,
  "selection_highlight": true,
  "rounded_selection": true,
  "current_line_highlight": "gutter",
  "cursor_shape": "underline",
  "cursor_blink": false,
  "ui_font_family": "Iosevka",
  "buffer_font_family": "Iosevka",
  "icon_theme": "Zed (Default)",
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "redact_private_values": true,
  "use_system_prompts": false,
  "use_system_path_prompts": false,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "keep_window_open",
  "debugger": {
    "dock": "right",
    "button": false
  },
  "terminal": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "proxy": "",
  "disable_ai": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Owl",
    "dark": "Owl"
  },
}
